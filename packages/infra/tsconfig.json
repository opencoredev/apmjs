{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["alchemy.run.ts", "release-cli.ts", "cli-*.ts", "smoke.ts", "deploy.ts", "incident-preflight.ts", "deploy-guard.ts", "install-checks.ts", "rollback.ts", "release-lock.ts", "stage.ts", "web-env.ts", "web-build.ts", "build-web.ts", "test/**/*.ts"]
}
