# The registry Worker's variables. packages/infra/alchemy.run.ts sets them on deploy (secrets come from
# ~/.config/apmjs, see docs/DEPLOY.md); `bun run registry` reads the same names from the environment.
# Never commit real values.

# The website's public origin. Sign-in callbacks, approval links and the `apm login` device page use it.
# The website forwards /api/auth/* and /-/apm/v1/* to the registry, so cookies live on this origin.
APM_PUBLIC_URL=https://apmjs.dev/

# The registry's public URL: tarball links in packuments point here.
APM_REGISTRY_URL=https://registry.apmjs.dev/

# Signs session cookies and encrypts TOTP secrets. Keep it stable: changing it signs everyone out and
# breaks every authenticator app set up so far. Generate with: openssl rand -base64 32
APM_AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers). Callback URL: <APM_PUBLIC_URL>api/auth/callback/github
# Without these, the GitHub button is hidden.
APM_GITHUB_CLIENT_ID=
APM_GITHUB_CLIENT_SECRET=

# Vercel integration OAuth (vercel.com/dashboard/integrations/console). Callback URL: <APM_PUBLIC_URL>api/auth/callback/vercel
# Without these, the Vercel button is hidden.
APM_VERCEL_CLIENT_ID=
APM_VERCEL_CLIENT_SECRET=

# npm's password adduser and password re-auth. Off in production: a typo there used to create an account.
# On a public https APM_PUBLIC_URL the registry refuses to serve with it on unless APM_ALLOW_LEGACY_IN_PROD=1.
APM_LEGACY_AUTH=0

# "scoped" (default): new packages must be @<your-github-login>/<name>. "open" allows bare names.
APM_NAME_POLICY=scoped

# The registry to proxy, or "off".
APM_UPSTREAM=https://registry.npmjs.org/

# Local development only (bun run registry).
APM_PORT=4873

# AI release review (docs/AI-REVIEW.md). sha256 (hex) of the reviewer's service token; unset means off.
# APM_REVIEW_TOKEN_HASH=
# GitHub logins that may confirm or dismiss flagged reviews.
# APM_ADMINS=
