{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  // these registry tests import Worker modules: packages/registry/tsconfig.test.json checks them with Workers types
  "exclude": ["packages/registry/test/tree-walk.test.ts", "packages/registry/test/analysis-recovery.test.ts", "packages/registry/test/resolve-pending.test.ts", "packages/registry/test/scan-integrity.test.ts", "packages/registry/test/deep-packument.test.ts", "packages/registry/test/analysis-stops.test.ts", "packages/registry/test/isolate-cache.test.ts", "packages/registry/test/upstream-route.test.ts", "packages/registry/test/packument-heap.workerd.test.ts", "packages/registry/test/memory-pool.test.ts", "packages/registry/test/memory-pool.workerd.test.ts", "packages/registry/test/tarball-stream.workerd.test.ts", "packages/registry/test/verified-stream.test.ts", "packages/registry/test/memory-pool-entry.ts", "packages/registry/test/walk-memory.test.ts", "packages/registry/test/walk-policy.test.ts", "packages/registry/test/summary-reserve.test.ts", "packages/registry/scripts/walk-memory.ts"],
  "include": ["scripts/dev-registry.ts", "packages/core/src/**/*.ts", "packages/cli/src/**/*.ts", "packages/bun-scanner/src/**/*.ts", "packages/ai-review/src/**/*.ts", "packages/registry/scripts/**/*.ts", "packages/*/test/**/*.ts", "apps/reviewer/src/**/*.ts", "tests/**/*.ts", "apps/web/cloudflare-env.d.ts", "scripts/lint.ts", "oxlint.config.ts"]
}
