{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  // these registry tests import Worker modules: packages/registry/tsconfig.test.json checks them with Workers types
  "exclude": ["packages/registry/test/tree-walk.test.ts", "packages/registry/test/analysis-recovery.test.ts", "packages/registry/test/resolve-pending.test.ts", "packages/registry/test/deep-packument.test.ts"],
  "include": ["scripts/dev-registry.ts", "packages/core/src/**/*.ts", "packages/cli/src/**/*.ts", "packages/bun-scanner/src/**/*.ts", "packages/ai-review/src/**/*.ts", "packages/registry/scripts/**/*.ts", "packages/*/test/**/*.ts", "apps/reviewer/src/**/*.ts", "tests/**/*.ts", "apps/web/cloudflare-env.d.ts", "scripts/lint.ts", "oxlint.config.ts"]
}
